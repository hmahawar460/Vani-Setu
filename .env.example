# ── LLM Providers (Multi-Model Orchestration) ─────────────────────────────────
# WisperFlow supports intelligent multi-model routing and automatic fallback:
# 1. Cerebras: Ultra-fast inference (llama-3.3-70b @ ~2000 tokens/s)
# 2. Groq: High-speed Whisper audio transcription + LLM (llama-3.3-70b-versatile)
# 3. OpenRouter: Multi-model resilient routing (meta-llama/llama-3.3-70b-instruct)

GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here

# LLM Provider selection: 'auto' | 'cerebras' | 'groq' | 'openrouter' | 'ollama'
# 'auto' prioritizes ultra-fast Cerebras -> Groq -> OpenRouter with automatic failover
LLM_PROVIDER=auto

# ── Optional but recommended ──────────────────────────────────────────────────
# HuggingFace token — increases rate limits for the IndicBARTSS (AI4Bharat) model
# Get free at https://huggingface.co/settings/tokens
HF_TOKEN=

# ── Server port (optional, defaults to 3001) ──────────────────────────────────
PORT=3001

# ─────────────────────────────────────────────────────────────────────────────
# Local Model Support (Ollama)
# ─────────────────────────────────────────────────────────────────────────────
# Set to true to route correction passes to Phi-4-mini via Ollama (free, MIT license).
# GROQ_API_KEY is still required for Whisper audio transcription even when USE_LOCAL_MODEL=true.
USE_LOCAL_MODEL=false

# Ollama endpoint (default for local installation)
OLLAMA_URL=http://localhost:11434

# Phi-4-mini is the recommended model — MIT license, free, runs locally via Ollama.
# Install: ollama pull phi4-mini
# Other options: llama3.1:8b, gemma2:9b
OLLAMA_MODEL=phi4-mini

# ─────────────────────────────────────────────────────────────────────────────
# Python ML Sidecar (autocorrect pipeline upgrade)
# ─────────────────────────────────────────────────────────────────────────────
# URL of the Python FastAPI sidecar that hosts Spello, GEC-mT5, hindiwsd.
# For local dev, run: cd ml_sidecar && uvicorn main:app --port 8000
# On Railway/Render the internal service URL is set automatically.
ML_SIDECAR_URL=http://localhost:8000
