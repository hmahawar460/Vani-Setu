# ── Required ──────────────────────────────────────────────────────────────────
# Get a free key at https://console.groq.com
# Free tier supports Whisper + Gemma 2 9B (Apache 2.0) for production use
GROQ_API_KEY=your_groq_api_key_here

# ── Optional but recommended ──────────────────────────────────────────────────
# HuggingFace token — increases rate limits for the IndicBARTSS (AI4Bharat) model
# Get free at https://huggingface.co/settings/tokens
# Without this the app still works but HF Inference API may be slower on first call
HF_TOKEN=

# ── Server port (optional, defaults to 3001) ──────────────────────────────────
PORT=3001
