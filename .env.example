# ── Required ──────────────────────────────────────────────────────────────────
# Get a free key at https://console.groq.com
# Free tier supports Whisper + Gemma 2 9B (Apache 2.0) for production use
GROQ_API_KEY=your_groq_api_key_here

# ── Optional but recommended ──────────────────────────────────────────────────
# HuggingFace token — increases rate limits for the IndicBARTSS (AI4Bharat) model
# Get free at https://huggingface.co/settings/tokens
# Without this the app still works but HF Inference API may be slower on first call
HF_TOKEN=

# ── Server port (optional, defaults to 3001) ──────────────────────────────────
PORT=3001

# ─────────────────────────────────────────────────────────────────────────────
# Local Model Support (Ollama)
# ─────────────────────────────────────────────────────────────────────────────
# Set this to true to use a local model instead of Groq for the autocorrect LLM
USE_LOCAL_MODEL=false

# Ollama endpoint (default for local installation)
OLLAMA_URL=http://localhost:11434

# Recommended local models (need to run `ollama pull model-name` first):
# - llama3.1:8b (Good balance of speed and Hindi accuracy)
# - gemma2:9b (Great reasoning, open weights)
OLLAMA_MODEL=llama3.1:8b
